# Copy to .env on AWS only. Never commit the populated file.
# Full Git commit SHA of the successful CI run (same tag for both images).
COURSEFLOW_IMAGE_PREFIX=ghcr.io/vkuryndin/courseflow
COURSEFLOW_IMAGE_TAG=

# Generate independent secrets on AWS: openssl rand -hex 32 / openssl rand -base64 32.
DB_PASSWORD=
JWT_SECRET_BASE64=
COURSEFLOW_ADMIN_EMAIL=
COURSEFLOW_ADMIN_PASSWORD=
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Initial access via SSH tunnel, not public unencrypted HTTP.
COURSEFLOW_BIND_ADDRESS=127.0.0.1
COURSEFLOW_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
COURSEFLOW_PASSWORD_RESET_URL=http://localhost:8081/reset-password

# Check against existing Docker networks and AWS routes before creating the network.
COURSEFLOW_SUBNET=172.30.253.0/24
COURSEFLOW_FRONTEND_IP=172.30.253.10
COURSEFLOW_BACKEND_IP=172.30.253.11
COURSEFLOW_DB_IP=172.30.253.12
