### 1. ADMIN creates SINGLE_CHOICE question — 201
POST http://localhost:8080/api/quizzes/{{quiz_id}}/questions
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "text": "Which Java data type is primitive?",
  "type": "SINGLE_CHOICE",
  "position": 1,
  "options": [
    {
      "text": "String",
      "correct": false
    },
    {
      "text": "int",
      "correct": true
    },
    {
      "text": "Integer",
      "correct": false
    }
  ]
}

> {%
    client.test("Single choice question created", function () {
        client.assert(response.status === 201);
    });

    client.global.set("question_1_id", response.body.id);

    client.global.set("question_1_correct_option_id",
        response.body.options.find(o => o.correct === true).id);

    client.global.set("question_1_wrong_option_id",
        response.body.options.find(o => o.correct === false).id);
%}


### 2. TEACHER creates MULTIPLE_CHOICE question — 201
POST http://localhost:8080/api/quizzes/{{quiz_id}}/questions
Authorization: Bearer {{enrollment_teacher_token}}
Content-Type: application/json

{
  "text": "Which Java data types are primitive?",
  "type": "MULTIPLE_CHOICE",
  "position": 2,
  "options": [
    {
      "text": "int",
      "correct": true
    },
    {
      "text": "double",
      "correct": true
    },
    {
      "text": "String",
      "correct": false
    },
    {
      "text": "Object",
      "correct": false
    }
  ]
}

> {%
    client.test("Multiple choice question created", function () {
        client.assert(response.status === 201);
    });

    client.global.set("question_2_id", response.body.id);

    let correct = response.body.options.filter(o => o.correct);

    client.global.set("question_2_correct_option_1_id",
        correct[0].id);

    client.global.set("question_2_correct_option_2_id",
        correct[1].id);

    client.global.set("question_2_wrong_option_id",
        response.body.options.find(o => !o.correct).id);
%}


