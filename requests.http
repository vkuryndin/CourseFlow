        client.assert(response.status === 200);
        client.assert(response.body.attempt.score === 100);
        client.assert(response.body.selectedAnswers.length === 3);

        response.body.selectedAnswers.forEach(answer => {
            client.assert(!("correct" in answer));
            client.assert(!("isCorrect" in answer));
        });
    });
%}


### 5. STUDENT reads second attempt details — 200
GET http://localhost:8080/api/quizzes/{{quiz_id}}/attempts/{{grading_attempt_2_id}}/result
Authorization: Bearer {{enrollment_student_token}}

> {%
    client.test("Second attempt result", function () {
        client.assert(response.status === 200);
        client.assert(response.body.attempt.score === 50);
        client.assert(response.body.selectedAnswers.length === 2);
    });
%}


