### =========================================================
### STAGE 5.4 — COURSE REVIEWS AND RATING
### =========================================================

### 1. Guest reads empty course rating — 200
GET http://localhost:8080/api/courses/{{course_id}}/reviews/rating


### 2. Student has no review yet — 404
GET http://localhost:8080/api/courses/{{course_id}}/reviews/me
Authorization: Bearer {{enrollment_student_token}}


### 3. Student creates review — 201
POST http://localhost:8080/api/courses/{{course_id}}/reviews
Authorization: Bearer {{enrollment_student_token}}
Content-Type: application/json

{
  "rating": 5,
  "comment": "Excellent course with useful lessons and assignments."
}

> {%
    client.test("Review created", function () {
        client.assert(response.status === 201);
        client.assert(response.body.rating === 5);
    });

    client.global.set("course_review_id", response.body.id);
%}


### 4. Student reads own review — 200
GET http://localhost:8080/api/courses/{{course_id}}/reviews/me
Authorization: Bearer {{enrollment_student_token}}


### 5. Guest reads public reviews — 200
GET http://localhost:8080/api/courses/{{course_id}}/reviews


### 6. Guest reads course rating — 200
GET http://localhost:8080/api/courses/{{course_id}}/reviews/rating

> {%
    client.test("Initial course rating", function () {
        client.assert(response.status === 200);
        client.assert(response.body.reviewCount === 1);
        client.assert(response.body.averageRating === 5);
    });
%}


### 7. Duplicate review — 409
POST http://localhost:8080/api/courses/{{course_id}}/reviews
Authorization: Bearer {{enrollment_student_token}}
Content-Type: application/json

{
  "rating": 4,
  "comment": "Second review must not be created."
}


### 8. Student updates own review — 200
PUT http://localhost:8080/api/courses/{{course_id}}/reviews/me
Authorization: Bearer {{enrollment_student_token}}
Content-Type: application/json

{
  "rating": 4,
  "comment": "Good course, but more practical examples would be useful."
}

> {%
    client.test("Review updated", function () {
        client.assert(response.status === 200);
        client.assert(response.body.rating === 4);
        client.assert(
            String(response.body.id) ===
            String(client.global.get("course_review_id"))
        );
    });
%}


### 9. Course rating is recalculated — 200
GET http://localhost:8080/api/courses/{{course_id}}/reviews/rating

> {%
    client.test("Updated course rating", function () {
        client.assert(response.status === 200);
        client.assert(response.body.reviewCount === 1);
        client.assert(response.body.averageRating === 4);
    });
%}


