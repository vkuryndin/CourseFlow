# CourseFlow — manual REST requests
# Execute requests in order. The timed scenarios and email recovery require individual execution.

@baseUrl = http://localhost:8080
@admin_email = admin@courseflow.local
@admin_password = 1234567890!qw
@test_password = CourseFlowTest2026!
@new_password = CourseFlowChanged2026!

# Password recovery: enter an email address you can receive mail at and the token from the email.
@reset_email = replace-me@example.com
@reset_token = REPLACE_WITH_EMAIL_TOKEN
@admin_reset_token = REPLACE_WITH_ADMIN_RESET_EMAIL_TOKEN
@reset_final_password = CourseFlowResetAgain2026!

# Authentication and system

### Login admin — 200
< {%
    [
        "manual_active_enrollments_before", "manual_admin_id", "manual_admin_token", "manual_assignment2_id", "manual_assignment_id",
        "manual_assignment_version", "manual_attempt1_id", "manual_attempt2_id", "manual_category_id", "manual_category_version",
        "manual_course_id", "manual_course_start", "manual_course_version", "manual_due_at", "manual_enrollment_id",
        "manual_expiry_attempt_id", "manual_expiry_module_id", "manual_expiry_quiz_id", "manual_expiry_quiz_version", "manual_extended_due",
        "manual_lesson_id", "manual_lesson_version", "manual_module_id", "manual_module_version", "manual_overdue_assignment_id",
        "manual_overdue_assignment_version", "manual_q1_correct_id", "manual_q1_wrong_id", "manual_q2_correct1_id", "manual_q2_correct2_id",
        "manual_question1_id", "manual_question2_id", "manual_quiz_id", "manual_quiz_version", "manual_reset_old_token",
        "manual_reset_user_id", "manual_review_id", "manual_run_id", "manual_session_end", "manual_session_id",
        "manual_session_start", "manual_session_version", "manual_short_due", "manual_student_email", "manual_student_id",
        "manual_student_token", "manual_submission_id", "manual_submission_version", "manual_tag_id", "manual_tag_version",
        "manual_teacher_email", "manual_teacher_id", "manual_teacher_token", "manual_teacher_version", "manual_total_enrollments_before"
    ].forEach(key => client.global.clear(key));
    const run = Date.now().toString();
    client.global.set("manual_run_id", run);
    client.global.set("manual_student_email", "manual.student." + run + "@courseflow.local");
    client.global.set("manual_teacher_email", "manual.teacher." + run + "@courseflow.local");
    function day(n) { const d = new Date(); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }
    client.global.set("manual_course_start", day(1));
    client.global.set("manual_session_start", day(3) + "T10:00:00Z");
    client.global.set("manual_session_end", day(3) + "T11:00:00Z");
    client.global.set("manual_due_at", day(20) + "T18:00:00Z");
    client.global.set("manual_extended_due", day(22) + "T18:00:00Z");
%}
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{"email":"{{admin_email}}","password":"{{admin_password}}"}

> {%
    if (response.status === 200) {
        client.global.set("manual_admin_token", String(response.body.accessToken));
        client.global.set("manual_admin_id", String(response.body.userId));
    }
%}

### Anonymous actuator health — 200
GET {{baseUrl}}/actuator/health

### System status (ADMIN) — 200
GET {{baseUrl}}/api/system/status
Authorization: Bearer {{manual_admin_token}}

### Admin system diagnostics — 200
GET {{baseUrl}}/api/system/info
Authorization: Bearer {{manual_admin_token}}

### Register student — 201
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "displayName": "Manual student {{manual_run_id}}",
  "email": "{{manual_student_email}}",
  "password": "{{test_password}}"
}

> {%
    if (response.status === 201) {
        client.global.set("manual_student_id", String(response.body.id));
    }
%}

### Login student with initial password — 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{manual_student_email}}",
  "password": "{{test_password}}"
}

> {%
    if (response.status === 200) {
        client.global.set("manual_student_token", String(response.body.accessToken));
        client.global.set("manual_student_id", String(response.body.userId));
    }
%}

### Own user profile — 200
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{manual_student_token}}

### Create teacher — 201
POST {{baseUrl}}/api/users
Authorization: Bearer {{manual_admin_token}}
Content-Type: application/json

{
  "displayName": "Manual teacher {{manual_run_id}}",
  "email": "{{manual_teacher_email}}",
  "password": "{{test_password}}",
  "passwordChangeRequired": false,
  "roles": [
    "STUDENT",
    "TEACHER"
  ]
}

> {%
    if (response.status >= 200 && response.status < 300 && response.body && typeof response.body.version === "number") {
        client.global.set("manual_teacher_version", String(response.body.version));
    }
    if (response.status === 201) {
        client.global.set("manual_teacher_id", String(response.body.id));
    }
%}

### Login teacher — 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{manual_teacher_email}}",
  "password": "{{test_password}}"
}

> {%
    if (response.status === 200) {
        client.global.set("manual_teacher_token", String(response.body.accessToken));
        client.global.set("manual_teacher_id", String(response.body.userId));
    }
%}

### Create own profile — 200
PUT {{baseUrl}}/api/users/me/profile
Authorization: Bearer {{manual_student_token}}
Content-Type: application/json

{"bio": "Learning Java and Hibernate", "avatarUrl": "https://example.org/avatar.png"}

### Read persisted profile — 200
GET {{baseUrl}}/api/users/me/profile
Authorization: Bearer {{manual_student_token}}

### Admin filters and sorts users — 200
GET {{baseUrl}}/api/users?q={{manual_run_id}}&status=ACTIVE&role=STUDENT&page=0&size=10&sortBy=displayName&direction=asc
Authorization: Bearer {{manual_admin_token}}

### Guest cannot read own user data — 401
GET {{baseUrl}}/api/users/me

### Student cannot list users — 403
GET {{baseUrl}}/api/users
Authorization: Bearer {{manual_student_token}}

