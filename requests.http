GET {{baseUrl}}/api/assignments/{{manual_assignment_id}}/submissions?status=SUBMITTED
Authorization: Bearer {{manual_teacher_token}}

### Grade homework — 200
PUT {{baseUrl}}/api/assignments/{{manual_assignment_id}}/submissions/{{manual_submission_id}}/grade
Authorization: Bearer {{manual_teacher_token}}
Content-Type: application/json

{"version": {{manual_submission_version}},
  "score": 90,
  "feedback": "Good explanation"
}

> {%
    if (response.status >= 200 && response.status < 300 && response.body && typeof response.body.version === "number") {
        client.global.set("manual_submission_version", String(response.body.version));
    }
%}

### Admin extends deadline — 200
PATCH {{baseUrl}}/api/lessons/{{manual_lesson_id}}/assignments/{{manual_assignment_id}}/deadline
Authorization: Bearer {{manual_admin_token}}
Content-Type: application/json

{"dueAt":"{{manual_extended_due}}","version":{{manual_assignment_version}}}

> {%
    if (response.status === 200) client.global.set("manual_assignment_version", String(response.body.version));
%}

### Teacher regrades an already graded submission — 200
PUT {{baseUrl}}/api/assignments/{{manual_assignment_id}}/submissions/{{manual_submission_id}}/grade
Authorization: Bearer {{manual_teacher_token}}
Content-Type: application/json

{"version":{{manual_submission_version}},"score":95,"feedback":"Revised evaluation"}

> {%
    if (response.status === 200) client.global.set("manual_submission_version", String(response.body.version));
%}

# Quizzes

### Create quiz — 201
POST {{baseUrl}}/api/modules/{{manual_module_id}}/quiz
Authorization: Bearer {{manual_teacher_token}}
Content-Type: application/json

{
  "title": "Java quiz",
  "timeLimit": 20
}

> {%
    if (response.status >= 200 && response.status < 300 && response.body && typeof response.body.version === "number") {
        client.global.set("manual_quiz_version", String(response.body.version));
    }
    if (response.status === 201) {
        client.global.set("manual_quiz_id", String(response.body.id));
    }
%}

### Update quiz settings — 200
PUT {{baseUrl}}/api/quizzes/{{manual_quiz_id}}
Authorization: Bearer {{manual_teacher_token}}
Content-Type: application/json

{"version": {{manual_quiz_version}},
  "title": "Java quiz updated",
  "timeLimit": 30,
  "maxAttempts": 2
}

> {%
    if (response.status >= 200 && response.status < 300 && response.body && typeof response.body.version === "number") {
        client.global.set("manual_quiz_version", String(response.body.version));
    }
%}

### Create single choice question — 201
POST {{baseUrl}}/api/quizzes/{{manual_quiz_id}}/questions
Authorization: Bearer {{manual_teacher_token}}
Content-Type: application/json

{
  "text": "Which type is primitive?",
  "type": "SINGLE_CHOICE",
  "position": 1,
  "options": [
    {
      "text": "String",
      "correct": false
    },
    {
      "text": "int",
      "correct": true
    },
    {
      "text": "Integer",
      "correct": false
    }
  ]
}

> {%
    if (response.status === 201) {
        client.global.set("manual_question1_id", String(response.body.id));
        client.global.set("manual_q1_correct_id", String(response.body.options.find(o => o.text === "int").id));
        client.global.set("manual_q1_wrong_id", String(response.body.options.find(o => o.text === "String").id));
    }
%}

### Create multiple choice question — 201
POST {{baseUrl}}/api/quizzes/{{manual_quiz_id}}/questions
Authorization: Bearer {{manual_teacher_token}}
Content-Type: application/json

{
  "text": "Which collections implement List?",
  "type": "MULTIPLE_CHOICE",
  "position": 2,
  "options": [
    {
      "text": "ArrayList",
      "correct": true
    },
    {
      "text": "LinkedList",
      "correct": true
    },
    {
      "text": "HashSet",
      "correct": false
    }
  ]
}

> {%
    if (response.status === 201) {
        client.global.set("manual_question2_id", String(response.body.id));
        client.global.set("manual_q2_correct1_id", String(response.body.options.find(o => o.text === "ArrayList").id));
        client.global.set("manual_q2_correct2_id", String(response.body.options.find(o => o.text === "LinkedList").id));
    }
%}

