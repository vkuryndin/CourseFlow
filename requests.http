Authorization: Bearer {{enrollment_student_token}}

> {%
    client.test("Correct answers are hidden", function () {
        client.assert(response.status === 200);
        client.assert(response.body.length === 2);

        response.body.forEach(question => {
            question.options.forEach(option => {
                client.assert(!("correct" in option),
                    "Correct answer leaked to student");
            });
        });
    });
%}


