### 020. Admin filters and sorts users — 200
GET {{baseUrl}}/api/users?q={{run_id}}&status=ACTIVE&role=STUDENT&page=0&size=10&sortBy=displayName&direction=asc
Authorization: Bearer {{admin_token}}

> {%
    client.test("020 Admin filters and sorts users", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.content.some(x => String(x.id) === client.global.get("student_id")));
        client.assert(response.body.content.some(x => String(x.id) === client.global.get("teacher_id")));
        client.assert(response.body.content.some(x => String(x.id) === client.global.get("other_id")));
        client.assert(response.body.totalElements === 3);
    });
%}


