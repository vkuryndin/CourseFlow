### Progress list returns summaries — 200
GET {{baseUrl}}/api/users/me/progress
Authorization: Bearer {{student_token}}

> {%
    client.test("Progress list returns summaries", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const c = response.body.content.find(x => String(x.courseId) === client.global.get("course_id"));
        client.assert(!!c && c.detailsIncluded === false);
        client.assert(c.totalAssessments === 3 && c.completedAssessments === 2 && c.progressPercent === 67 && c.performancePercent === 95);
        client.assert(c.totalAssignments === 2 && c.totalQuizzes === 1 && c.totalUpcomingDeadlines === 1);
        client.assert(c.assignments.length === 0 && c.quizzes.length === 0 && c.upcomingDeadlines.length === 0);
    });
%}

### Progress details first page — 200
GET {{baseUrl}}/api/users/me/progress?courseId={{course_id}}&detailPage=0&detailSize=1
Authorization: Bearer {{student_token}}

> {%
    client.test("Progress details first page", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const c = response.body.content[0];
        client.assert(c.detailsIncluded === true && c.detailPage === 0 && c.detailSize === 1);
        client.assert(c.totalAssignments === 2 && c.totalQuizzes === 1 && c.totalUpcomingDeadlines === 1);
        client.assert(c.assignments.length === 1 && c.quizzes.length === 1 && c.upcomingDeadlines.length === 1);
        client.assert(c.totalAssessments === 3 && c.completedAssessments === 2 && c.progressPercent === 67 && c.performancePercent === 95);
        client.global.set("gradebook_first_assignment", String(c.assignments[0].assignmentId));
    });
%}

