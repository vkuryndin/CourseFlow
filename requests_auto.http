# Regrading and authorization

### Teacher regrades an already graded submission — 200
< {%
    client.global.set("authorization_previous_grade_version", client.global.get("submission_version"));
%}
PUT {{baseUrl}}/api/assignments/{{assignment_id}}/submissions/{{submission_id}}/grade
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{"version":{{submission_version}},"score":95,"feedback":"Revised evaluation"}

> {%
    client.test("Teacher regrades an already graded submission", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.status === "GRADED");
        client.assert(response.body.score === 95);
        client.assert(response.body.feedback === "Revised evaluation");
        client.assert(response.body.version > Number(client.global.get("authorization_previous_grade_version")));
        client.global.set("submission_version", String(response.body.version));
    });
%}

### Stale regrade cannot overwrite committed grade — 409
PUT {{baseUrl}}/api/assignments/{{assignment_id}}/submissions/{{submission_id}}/grade
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{"version":{{authorization_previous_grade_version}},"score":20,"feedback":"Stale evaluation"}

