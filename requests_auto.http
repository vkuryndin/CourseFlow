### 247. My current assignments — 200
GET {{baseUrl}}/api/users/me/assignments?courseId={{course_id}}
Authorization: Bearer {{student_token}}

> {%
    client.test("247 My current assignments", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.totalElements === 2);
        const graded = response.body.content.find(x => String(x.assignmentId) === client.global.get("assignment_id"));
        client.assert(graded.status === "GRADED" && graded.score === 90);
        const pending = response.body.content.find(x => String(x.assignmentId) === client.global.get("assignment2_id"));
        client.assert(pending.status === "NOT_SUBMITTED" && pending.score === null);
    });
%}

