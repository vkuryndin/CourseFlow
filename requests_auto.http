### 133. Create single choice question — 201
POST {{baseUrl}}/api/quizzes/{{quiz_id}}/questions
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{
  "text": "Which type is primitive?",
  "type": "SINGLE_CHOICE",
  "position": 1,
  "options": [
    {
      "text": "String",
      "correct": false
    },
    {
      "text": "int",
      "correct": true
    },
    {
      "text": "Integer",
      "correct": false
    }
  ]
}

> {%
    client.test("133 Create single choice question", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.options.filter(o => o.correct).length === 1);
    });
    if (response.status === 201) {
        client.global.set("question1_id", String(response.body.id));
        client.global.set("q1_correct_id", String(response.body.options.find(o => o.text === "int").id));
        client.global.set("q1_wrong_id", String(response.body.options.find(o => o.text === "String").id));
    }
%}


