        const teacher = response.body.content.find(x => String(x.id) === client.global.get("teacher_id"));
        client.assert(!!teacher);
        client.assert(teacher.displayName === "Regression teacher " + client.global.get("run_id"));
        client.assert(!Object.prototype.hasOwnProperty.call(teacher, "email"));
        client.assert(!Object.prototype.hasOwnProperty.call(teacher, "roles"));
    });
%}

