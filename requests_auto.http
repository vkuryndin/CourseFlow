# Gradebook and progress pagination

### Gradebook first column page — 200
GET {{baseUrl}}/api/courses/{{course_id}}/gradebook?columnPage=0&columnSize=1
Authorization: Bearer {{teacher_token}}

> {%
    client.test("Gradebook first column page", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const b = response.body;
        client.assert(b.columnPage === 0 && b.columnSize === 1 && b.totalColumns === 3 && b.totalColumnPages === 3);
        client.assert(b.columns.length === 1 && b.columns[0].type === "ASSIGNMENT");
        client.assert(b.students.content.length > 0);
        client.assert(b.students.content.every(x => x.results.length === 1 && x.results[0].assessmentId === b.columns[0].id));
        client.global.set("gradebook_first_column", String(b.columns[0].id));
    });
%}

### Gradebook second column page — 200
GET {{baseUrl}}/api/courses/{{course_id}}/gradebook?columnPage=1&columnSize=1
Authorization: Bearer {{teacher_token}}

> {%
    client.test("Gradebook second column page", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const b = response.body;
        client.assert(b.columnPage === 1 && b.totalColumns === 3);
        client.assert(b.columns.length === 1 && b.columns[0].type === "ASSIGNMENT");
        client.assert(String(b.columns[0].id) !== client.global.get("gradebook_first_column"));
        client.assert(b.students.content.every(x => x.results.length === 1 && x.results[0].assessmentId === b.columns[0].id));
    });
%}

### Gradebook quiz column page — 200
