### Teacher extends deadline after grading — 200
< {%
    client.global.set("deadline_old_version", client.global.get("assignment_version"));
%}
PATCH {{baseUrl}}/api/lessons/{{lesson_id}}/assignments/{{assignment_id}}/deadline
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{"dueAt":"{{deadline_later_due}}","version":{{assignment_version}}}

> {%
    client.test("Teacher extends deadline after grading", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(Date.parse(response.body.dueAt) === Date.parse(client.global.get("deadline_later_due")));
        client.assert(response.body.title === "Java homework 1 updated");
        client.assert(response.body.description === "Explain JVM, JDK and JRE");
        client.assert(response.body.maxScore === 100);
        client.assert(response.body.version > Number(client.global.get("deadline_old_version")));
        client.global.set("assignment_version", String(response.body.version));
    });
%}

