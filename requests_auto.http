### 182. Student dashboard — 200
GET {{baseUrl}}/api/dashboard/student
Authorization: Bearer {{student_token}}

> {%
    client.test("182 Student dashboard", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.activeCourseCount === 1);
        const course = response.body.courses.content.find(x => String(x.courseId) === client.global.get("course_id"));
        client.assert(!!course);
        client.assert(course.totalAssessments === 3 && course.completedAssessments === 2);
        client.assert(course.progressPercent === 67 && course.performancePercent === 95);
        client.assert(course.assignments === undefined && course.quizzes === undefined);
        const session = response.body.upcomingSessions.find(x => String(x.sessionId) === client.global.get("session_id"));
        client.assert(!!session);
        client.assert(String(session.courseId) === client.global.get("course_id"));
        client.assert(String(session.lessonId) === client.global.get("lesson_id"));
        client.assert(session.format === "ONLINE" && typeof session.meetingUrl === "string");
        client.assert(typeof session.startsAt === "string" && typeof session.endsAt === "string");
        client.global.set("cf618_student_session", JSON.stringify([session.sessionId, session.courseId, session.courseTitle, session.lessonId, session.lessonTitle, session.startsAt, session.endsAt, session.format, session.meetingUrl]));
        client.assert(response.body.upcomingDeadlines.some(x => String(x.assignmentId) === client.global.get("assignment2_id")));
    });
%}


### 183. Teacher dashboard graded work removed — 200
GET {{baseUrl}}/api/dashboard/teacher
Authorization: Bearer {{teacher_token}}

> {%
    client.test("183 Teacher dashboard graded work removed", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.pendingSubmissionCount === 0);
        const session = response.body.upcomingSessions.find(x => String(x.sessionId) === client.global.get("session_id"));
        client.assert(!!session);
        const studentSession = JSON.parse(client.global.get("cf618_student_session"));
        ["sessionId", "courseId", "courseTitle", "lessonId", "lessonTitle", "startsAt", "endsAt", "format", "meetingUrl"].forEach((field, index) =>
            client.assert(session[field] === studentSession[index], "Session differs: " + field));
        client.assert(response.body.recentQuizResults.length === 2);
        client.assert(response.body.recentQuizResults.some(x => String(x.attemptId) === client.global.get("attempt1_id")));
        client.assert(response.body.recentQuizResults.some(x => String(x.attemptId) === client.global.get("attempt2_id")));
    });
%}


### 184. Admin dashboard — 200
GET {{baseUrl}}/api/dashboard/admin
Authorization: Bearer {{admin_token}}

> {%
    client.test("184 Admin dashboard", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.users.total === response.body.users.active + response.body.users.inactive + response.body.users.deleted);
        client.assert(response.body.courses.total === response.body.courses.active + response.body.courses.archived);
        client.assert(response.body.enrollments.total === response.body.enrollments.active + response.body.enrollments.withdrawn);
        client.assert(response.body.enrollments.activeOnActiveCourses <= response.body.enrollments.active);
    });
    if (response.status === 200) {
        client.global.set("active_enrollments_before", String(response.body.enrollments.active));
        client.global.set("total_enrollments_before", String(response.body.enrollments.total));
    }
%}


