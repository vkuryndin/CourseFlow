# CourseFlow — REST regression
# IntelliJ HTTP Client: Run All Requests in File (dev profile).
# Each run creates a separate set of test data.

@baseUrl = http://localhost:8080
@admin_email = admin@courseflow.local
@admin_password = 1234567890!qw
@test_password = CourseFlowTest2026!
@new_password = CourseFlowChanged2026!

# System, authentication and users

### Login admin — 200
< {%
    [
        "active_enrollments_before", "admin_id", "admin_token", "assignment2_id", "assignment_id",
        "assignment_version", "attempt1_id", "attempt2_id", "category_id", "category_version",
        "reorder_course_version", "reorder_lesson3_id", "reorder_lesson3_version", "reorder_lesson4_id", "reorder_lesson4_version",
        "reorder_lesson_version", "reorder_module3_id", "reorder_module3_version", "reorder_module4_id", "reorder_module4_version",
        "reorder_module_version", "reorder_session_version", "gradebook_first_assignment", "gradebook_first_column", "validation_student_session",
        "validation_user_id", "deadline_admin_due", "deadline_earlier_due", "deadline_later_due", "deadline_old_version",
        "deadline_past_due", "authorization_auth_email", "authorization_auth_id", "authorization_auth_token", "authorization_previous_grade_version",
        "course_id", "course_start", "course_version", "due_at", "enrollment_id",
        "lesson_id", "lesson_version", "module_id", "module_version", "other_email",
        "other_id", "other_token", "other_updated_email", "other_version", "oversized_answers",
        "oversized_content", "q1_correct_id", "q1_wrong_id", "q2_correct1_id", "q2_correct2_id",
        "question1_id", "question2_id", "quiz_id", "quiz_version", "review_id",
        "run_id", "session_end", "session_id", "session_new_end", "session_new_start",
        "session_start", "session_version", "stale_course_version", "student_email", "student_id",
        "student_token", "student_version", "submission_id", "submission_version", "tag_id",
        "tag_version", "teacher_email", "teacher_id", "teacher_token", "teacher_version",
        "temp_assignment_id", "temp_category_id", "temp_category_version", "temp_course_id", "temp_course_version",
        "temp_lesson_id", "temp_module_id", "temp_password_email", "temp_password_new_token", "temp_password_token",
        "temp_question_id", "temp_question_version", "temp_quiz_id", "temp_session_end", "temp_session_id",
        "temp_session_start", "total_enrollments_before", "version_test_tag_id", "version_test_tag_version"
    ].forEach(key => client.global.clear(key));
    // Unique test data and relative dates.
    const run = Date.now().toString();
    client.global.set("run_id", run);
    client.global.set("student_version", "0");
    client.global.set("temp_password_email", "reg.temporary.password." + run + "@courseflow.local");
    function day(n) { const d = new Date(); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }
    client.global.set("course_start", day(1));
    client.global.set("session_start", day(3) + "T10:00:00Z");
    client.global.set("session_end", day(3) + "T11:00:00Z");
    client.global.set("session_new_start", day(3) + "T12:00:00Z");
    client.global.set("session_new_end", day(3) + "T13:00:00Z");
    client.global.set("temp_session_start", day(4) + "T10:00:00Z");
    client.global.set("temp_session_end", day(4) + "T11:00:00Z");
    client.global.set("due_at", day(20) + "T18:00:00Z");
    client.global.set("deadline_earlier_due", day(19) + "T18:00:00Z");
    client.global.set("deadline_later_due", day(21) + "T18:00:00Z");
    client.global.set("deadline_admin_due", day(22) + "T18:00:00Z");
    client.global.set("deadline_past_due", day(-1) + "T18:00:00Z");
    client.global.set("student_email", "reg.student." + run + "@courseflow.local");
    client.global.set("teacher_email", "reg.teacher." + run + "@courseflow.local");
    client.global.set("other_email", "reg.other." + run + "@courseflow.local");
    client.global.set("other_updated_email", "reg.other.updated." + run + "@courseflow.local");
%}
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{admin_email}}",
  "password": "{{admin_password}}"
}

> {%
    client.test("Login admin", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(typeof response.body.accessToken === "string");
    });
    if (response.status === 200) {
        client.global.set("admin_token", String(response.body.accessToken));
        client.global.set("admin_id", String(response.body.userId));
    }
%}

### System status (ADMIN) — 200
GET {{baseUrl}}/api/system/status
Authorization: Bearer {{admin_token}}

> {%
    client.test("System status", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.application === "CourseFlow");
        client.assert(response.body.status === "UP");
        client.assert(response.body.database === "CONNECTED");
        client.assert(/^[0-9a-f-]{36}$/.test(response.headers.valueOf("X-Request-Id")));
    });
%}

### Admin system diagnostics — 200
GET {{baseUrl}}/api/system/info
Authorization: Bearer {{admin_token}}

> {%
    client.test("Admin system diagnostics", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.headers.valueOf("Cache-Control") === "no-store");
        const snapshot = response.body.snapshot;
        client.assert(snapshot.application.name === "courseflow");
        client.assert(snapshot.database.status === "CONNECTED");
        client.assert(typeof snapshot.runtime.javaVersion === "string");
        client.assert(snapshot.mail.status === "NOT_CHECKED");
        client.assert(!Object.prototype.hasOwnProperty.call(snapshot.database, "password"));
        client.assert(!Object.prototype.hasOwnProperty.call(snapshot.database, "url"));
        client.assert(!Object.prototype.hasOwnProperty.call(snapshot.mail, "password"));
    });
%}

### Guest cannot read system diagnostics — 401
GET {{baseUrl}}/api/system/info

> {%
    client.test("Guest cannot read system diagnostics", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### Anonymous actuator health — status only
GET {{baseUrl}}/actuator/health

> {%
    client.test("Anonymous actuator health", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.status === "UP");
        client.assert(response.body.components == null, "Health must not disclose components");
        client.assert(response.body.details == null, "Health must not disclose details");
        client.assert(/^[0-9a-f-]{36}$/.test(response.headers.valueOf("X-Request-Id")));
    });
%}

### Allow configured React CORS preflight — 200
OPTIONS {{baseUrl}}/api/users/me
Origin: http://localhost:5173
Access-Control-Request-Method: GET
Access-Control-Request-Headers: authorization

> {%
    client.test("Allow configured React CORS preflight", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.headers.valueOf("Access-Control-Allow-Origin") === "http://localhost:5173");
    });
%}

