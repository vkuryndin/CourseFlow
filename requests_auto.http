### 270. OpenAPI describes every REST operation — 200
GET {{baseUrl}}/v3/api-docs
Accept: application/json

> {%
    client.test("270 OpenAPI describes every REST operation", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const doc = response.body;
        client.assert(doc.info.title === "CourseFlow REST API");
        client.assert(doc.components.securitySchemes.bearerAuth.scheme === "bearer");
        client.assert(doc.security.some(x => Object.prototype.hasOwnProperty.call(x, "bearerAuth")));
        const expected = [
            "delete /api/categories/{id}",
            "delete /api/courses/{courseId}/enrollments/me",
            "delete /api/courses/{courseId}/enrollments/students/{studentId}",
            "delete /api/courses/{courseId}/modules/{moduleId}",
            "delete /api/courses/{courseId}/modules/{moduleId}/lessons/{lessonId}",
            "delete /api/courses/{courseId}/reviews/me",
            "delete /api/courses/{courseId}/tags/{tagId}",
            "delete /api/courses/{id}",
            "delete /api/lessons/{lessonId}/assignments/{assignmentId}",
            "delete /api/lessons/{lessonId}/sessions/{sessionId}",
            "delete /api/quizzes/{quizId}",
            "delete /api/quizzes/{quizId}/questions/{questionId}",
            "delete /api/tags/{id}",
            "delete /api/users/{id}",
            "get /api/assignments/{assignmentId}/submissions",
            "get /api/assignments/{assignmentId}/submissions/me",
            "get /api/categories",
            "get /api/categories/{id}",
            "get /api/courses",
            "get /api/courses/{courseId}/enrollments",
            "get /api/courses/{courseId}/enrollments/me",
            "get /api/courses/{courseId}/gradebook",
            "get /api/courses/{courseId}/modules",
            "get /api/courses/{courseId}/modules/{moduleId}",
            "get /api/courses/{courseId}/modules/{moduleId}/lessons",
            "get /api/courses/{courseId}/modules/{moduleId}/lessons/{lessonId}",
            "get /api/courses/{courseId}/reviews",
            "get /api/courses/{courseId}/reviews/me",
            "get /api/courses/{courseId}/reviews/rating",
            "get /api/courses/{courseId}/tags",
            "get /api/courses/{id}",
            "get /api/dashboard/admin",
            "get /api/dashboard/student",
            "get /api/dashboard/teacher",
            "get /api/lessons/{lessonId}/assignments",
            "get /api/lessons/{lessonId}/assignments/{assignmentId}",
            "get /api/lessons/{lessonId}/sessions",
            "get /api/lessons/{lessonId}/sessions/{sessionId}",
            "get /api/modules/{moduleId}/quiz",
            "get /api/quizzes/{quizId}",
            "get /api/quizzes/{quizId}/attempts",
            "get /api/quizzes/{quizId}/attempts/me",
            "get /api/quizzes/{quizId}/attempts/{attemptId}",
            "get /api/quizzes/{quizId}/attempts/{attemptId}/manage",
            "get /api/quizzes/{quizId}/attempts/{attemptId}/result",
            "get /api/quizzes/{quizId}/questions",
            "get /api/quizzes/{quizId}/questions/manage",
            "get /api/system/status",
            "get /api/tags",
            "get /api/tags/{id}",
            "get /api/teachers/{id}",
            "get /api/users",
            "get /api/users/me",
            "get /api/users/me/assignments",
            "get /api/users/me/enrollments",
            "get /api/users/me/profile",
            "get /api/users/me/progress",
            "get /api/users/me/quiz-attempts",
            "get /api/users/me/submissions",
            "get /api/users/{id}",
            "patch /api/courses/{courseId}/modules/{moduleId}/lessons/{lessonId}/position",
            "patch /api/courses/{courseId}/modules/{moduleId}/position",
            "patch /api/lessons/{lessonId}/assignments/{assignmentId}/deadline",
            "patch /api/lessons/{lessonId}/sessions/{sessionId}/time",
            "post /api/assignments/{assignmentId}/submissions",
            "post /api/auth/change-password",
            "post /api/auth/forgot-password",
            "post /api/auth/login",
            "post /api/auth/logout",
            "post /api/auth/register",
            "post /api/auth/reset-password",
            "post /api/categories",
            "post /api/courses",
            "post /api/courses/{courseId}/enrollments",
            "post /api/courses/{courseId}/modules",
            "post /api/courses/{courseId}/modules/{moduleId}/lessons",
            "post /api/courses/{courseId}/reviews",
            "post /api/courses/{courseId}/tags/{tagId}",
            "post /api/courses/{id}/archive",
            "post /api/lessons/{lessonId}/assignments",
            "post /api/lessons/{lessonId}/sessions",
            "post /api/modules/{moduleId}/quiz",
            "post /api/quizzes/{quizId}/attempts",
            "post /api/quizzes/{quizId}/attempts/{attemptId}/submit",
            "post /api/quizzes/{quizId}/questions",
            "post /api/tags",
            "post /api/users",
            "post /api/users/{id}/activate",
            "post /api/users/{id}/deactivate",
            "post /api/users/{id}/password-reset",
            "put /api/assignments/{assignmentId}/submissions/{submissionId}/grade",
            "put /api/categories/{id}",
            "put /api/courses/{courseId}/modules/{moduleId}",
            "put /api/courses/{courseId}/modules/{moduleId}/lessons/{lessonId}",
            "put /api/courses/{courseId}/reviews/me",
            "put /api/courses/{courseId}/teacher",
            "put /api/courses/{id}",
            "put /api/lessons/{lessonId}/assignments/{assignmentId}",
            "put /api/lessons/{lessonId}/sessions/{sessionId}",
            "put /api/quizzes/{quizId}",
            "put /api/quizzes/{quizId}/questions/{questionId}",
            "put /api/tags/{id}",
            "put /api/users/me/profile",
            "put /api/users/{id}",
            "put /api/users/{id}/roles",
        ];
        expected.forEach(route => {
            const [method, path] = route.split(" ");
            client.assert(doc.paths[path] && doc.paths[path][method], "Missing OpenAPI operation: " + route);
        });
        client.assert(Array.isArray(doc.paths["/api/auth/login"].post.security));
        client.assert(doc.paths["/api/auth/login"].post.security.length === 0);
        client.assert(doc.paths["/api/categories"].get.security.length === 0);
        const protectedOp = doc.paths["/api/dashboard/admin"].get;
        client.assert(protectedOp.security === undefined || protectedOp.security.some(x => x.bearerAuth !== undefined));
        // Public endpoint policy is shared by Spring Security and Swagger.
        const publicGet = ["/api/categories", "/api/categories/{id}", "/api/tags", "/api/tags/{id}",
            "/api/courses", "/api/courses/{id}", "/api/courses/{courseId}/tags",
            "/api/courses/{courseId}/modules", "/api/courses/{courseId}/modules/{moduleId}",
            "/api/teachers/{id}", "/api/courses/{courseId}/reviews", "/api/courses/{courseId}/reviews/rating"];
        publicGet.forEach(path => client.assert(Array.isArray(doc.paths[path].get.security) &&
            doc.paths[path].get.security.length === 0, "Public GET security: " + path));
        ["register", "login", "forgot-password", "reset-password", "change-password"].forEach(name => {
            const op = doc.paths["/api/auth/" + name].post;
            client.assert(op.responses["429"] !== undefined, "Missing 429: " + name);
            client.assert(op.responses["429"].headers["Retry-After"] !== undefined, "Missing Retry-After: " + name);
            if (name !== "change-password") client.assert(Array.isArray(op.security) && op.security.length === 0);
            else client.assert(op.security === undefined || op.security.some(x => x.bearerAuth !== undefined));
        });
        ["/api/courses/{courseId}/reviews/me", "/api/users/me/progress", "/api/courses/{courseId}/gradebook"].forEach(path => {
            const op = doc.paths[path].get;
            client.assert(op.security === undefined || op.security.some(x => x.bearerAuth !== undefined), "Protected GET: " + path);
        });
        client.assert(doc.paths["/api/auth/register"].post.responses["201"] !== undefined);
        client.assert(doc.paths["/api/auth/logout"].post.responses["204"] !== undefined);
        client.assert(doc.components.schemas && doc.components.schemas.ApiErrorResponse !== undefined, "Missing OpenAPI schema: ApiErrorResponse");
    });
%}

