# CourseFlow — consolidated REST regression scenario
# Baseline: CourseFlow 6.23 (includes 6.20 deadline extension).
# IntelliJ HTTP Client: Run All Requests in File, sequentially from 001.
# Each run generates fresh test data; no DB reset required.
# If rate limited (429), respect Retry-After before repeating.
# Optional manual scenarios are commented out at the end.
# Local development only. Do not commit real administrator credentials.

@baseUrl = http://localhost:8080
@admin_email = admin@courseflow.local
@admin_password = 1234567890!qw
@test_password = CourseFlowTest2026!
@new_password = CourseFlowChanged2026!


# ========================================================================
# 01 — SYSTEM / AUTH / IDENTITIES
# ========================================================================

### 001. Login admin — 200
< {%
    // Remove only variables owned by this scenario, to avoid stale IDs after a failed run.
    [
        "assignment_version", "course_version", "lesson_version", "module_version", "other_version", "quiz_version", "session_version", "student_version", "submission_version", "teacher_version", "temp_course_version", "temp_question_version",
        "temp_password_email", "temp_password_token", "temp_password_new_token", "stale_course_version",
        "active_enrollments_before", "admin_id", "admin_token", "assignment2_id",
        "assignment_id", "attempt1_id", "attempt2_id", "category_id",
        "course_id", "course_start", "due_at", "enrollment_id",
        "lesson_id", "module_id", "other_email", "other_id",
        "other_token", "other_updated_email", "q1_correct_id", "q1_wrong_id",
        "q2_correct1_id", "q2_correct2_id", "question1_id", "question2_id",
        "quiz_id", "review_id", "run_id", "session_end",
        "session_id", "session_new_end", "session_new_start", "session_start",
        "student_email", "student_id", "student_token", "submission_id",
        "tag_id", "teacher_email", "teacher_id", "teacher_token",
        "temp_assignment_id", "temp_category_id", "temp_course_id", "temp_lesson_id", "temp_module_id",
        "temp_question_id", "temp_quiz_id", "temp_session_end", "temp_session_id",
        "temp_session_start", "total_enrollments_before", "oversized_content", "oversized_answers"
    ].forEach(k => client.global.clear(k));
    ["cf614_course_version", "cf614_lesson3_id", "cf614_lesson3_version", "cf614_lesson4_id", "cf614_lesson4_version", "cf614_lesson_version", "cf614_module3_id", "cf614_module3_version", "cf614_module4_id", "cf614_module4_version", "cf614_module_version", "cf614_session_version"].forEach(k => client.global.clear(k));
    ["cf615_first_column", "cf615_first_assignment", "cf618_student_session", "cf618_user_id"].forEach(k => client.global.clear(k));
    // Unique fixture namespace. Dates relative to this run.
    const run = Date.now().toString();
    client.global.set("run_id", run);
    client.global.set("student_version", "0");
    client.global.set("temp_password_email", "reg.temporary.password." + run + "@courseflow.local");
    function day(n) { const d = new Date(); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }
    client.global.set("course_start", day(1));
    client.global.set("session_start", day(3) + "T10:00:00Z");
    client.global.set("session_end", day(3) + "T11:00:00Z");
    client.global.set("session_new_start", day(3) + "T12:00:00Z");
    client.global.set("session_new_end", day(3) + "T13:00:00Z");
    client.global.set("temp_session_start", day(4) + "T10:00:00Z");
    client.global.set("temp_session_end", day(4) + "T11:00:00Z");
    client.global.set("due_at", day(20) + "T18:00:00Z");
    client.global.set("cf620_earlier_due", day(19) + "T18:00:00Z");
    client.global.set("cf620_later_due", day(21) + "T18:00:00Z");
    client.global.set("cf620_admin_due", day(22) + "T18:00:00Z");
    client.global.set("cf620_past_due", day(-1) + "T18:00:00Z");
    client.global.clear("cf620_old_version");
    client.global.set("student_email", "reg.student." + run + "@courseflow.local");
    client.global.set("teacher_email", "reg.teacher." + run + "@courseflow.local");
    client.global.set("other_email", "reg.other." + run + "@courseflow.local");
    client.global.set("other_updated_email", "reg.other.updated." + run + "@courseflow.local");
%}
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{admin_email}}",
  "password": "{{admin_password}}"
}

> {%
    client.test("001 Login admin", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(typeof response.body.accessToken === "string");
    });
    if (response.status === 200) {
        client.global.set("admin_token", String(response.body.accessToken));
        client.global.set("admin_id", String(response.body.userId));
    }
%}


### 002. System status (ADMIN) — 200
GET {{baseUrl}}/api/system/status
Authorization: Bearer {{admin_token}}

> {%
    client.test("002 System status", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.application === "CourseFlow");
        client.assert(response.body.status === "UP");
        client.assert(response.body.database === "CONNECTED");
        client.assert(/^[0-9a-f-]{36}$/.test(response.headers.valueOf("X-Request-Id")));
    });
%}


### 003. Anonymous actuator health — status only
GET {{baseUrl}}/actuator/health

> {%
    client.test("003 Anonymous actuator health", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.status === "UP");
        client.assert(response.body.components == null, "Health must not disclose components");
        client.assert(response.body.details == null, "Health must not disclose details");
        client.assert(/^[0-9a-f-]{36}$/.test(response.headers.valueOf("X-Request-Id")));
    });
%}


### 004. Allow configured React CORS preflight — 200
OPTIONS {{baseUrl}}/api/users/me
Origin: http://localhost:5173
Access-Control-Request-Method: GET
Access-Control-Request-Headers: authorization

> {%
    client.test("004 Allow configured React CORS preflight", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.headers.valueOf("Access-Control-Allow-Origin") === "http://localhost:5173");
    });
%}


### 005. Reject untrusted CORS origin — 403
OPTIONS {{baseUrl}}/api/users/me
Origin: https://untrusted.example
Access-Control-Request-Method: GET
Access-Control-Request-Headers: authorization

> {%
    client.test("005 Reject untrusted CORS origin", function () {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}


### 006. Register student — 201
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "displayName": "Regression student {{run_id}}",
  "email": "{{student_email}}",
  "password": "{{test_password}}"
}

> {%
    client.test("006 Register student", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.roles.includes("STUDENT"));
    });
    if (response.status === 201) {
        client.global.set("student_id", String(response.body.id));
    }
%}


