Authorization: Bearer {{admin_token}}

> {%
    client.test("Admin enrollment count updated", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.enrollments.active === Number(client.global.get("active_enrollments_before")) - 1);
        client.assert(response.body.enrollments.total === Number(client.global.get("total_enrollments_before")));
    });
%}

