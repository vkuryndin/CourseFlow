# UTF-8 password validation

### Register rejects 74 UTF-8 bytes — 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{"displayName":"UTF8 test","email":"reg.utf8.{{run_id}}@courseflow.local","password":"яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя"}

> {%
    client.test("Register rejects 74 UTF-8 bytes", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
        client.assert(response.body.code === "BAD_REQUEST");
        client.assert(response.body.message === "Password must not exceed 72 UTF-8 bytes");
    });
%}

