### Admin counter courseflow.password.reset.requests
GET {{baseUrl}}/actuator/metrics/courseflow.password.reset.requests
Authorization: Bearer {{admin_token}}

> {%
    client.test("Admin counter courseflow.password.reset.requests", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.name === "courseflow.password.reset.requests");
        const count = response.body.measurements.find(m => m.statistic === "COUNT");
        client.assert(count && typeof count.value === "number" && count.value >= 1, "Invalid counter");
        client.assert(Array.isArray(response.body.availableTags) && response.body.availableTags.length === 0, "Custom metric must have no identifying tags");
    });
%}

